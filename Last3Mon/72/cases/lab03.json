{
  "webhook": "my-helpdesk",
  "after": [
    {
      "url": "http://localhost:8800/admin/fault",
      "body": {
        "faq": "ok",
        "tickets": "ok"
      }
    }
  ],
  "cases": [
    {
      "name": "평소",
      "request": "requests/faq-vpn-nocache.json",
      "expect": {
        "equals": {
          "route": "자동 답변"
        }
      }
    },
    {
      "name": "FAQ가 느릴 때 (8초)",
      "before": [
        {
          "url": "http://localhost:8800/admin/fault",
          "body": {
            "faq": "slow",
            "slow_seconds": 8
          }
        }
      ],
      "after": [
        {
          "url": "http://localhost:8800/admin/fault",
          "body": {
            "faq": "ok",
            "tickets": "ok"
          }
        }
      ],
      "body": {
        "question": "비밀번호를 잊어버렸어요",
        "user": "한지훈",
        "no_cache": true
      },
      "expect": {
        "status": 200,
        "equals": {
          "route": "담당자 연결"
        },
        "max_seconds": 7
      }
    },
    {
      "name": "FAQ가 오류일 때 (500)",
      "before": [
        {
          "url": "http://localhost:8800/admin/fault",
          "body": {
            "faq": "error"
          }
        }
      ],
      "after": [
        {
          "url": "http://localhost:8800/admin/fault",
          "body": {
            "faq": "ok",
            "tickets": "ok"
          }
        }
      ],
      "body": {
        "question": "비밀번호를 잊어버렸어요",
        "user": "한지훈",
        "no_cache": true
      },
      "expect": {
        "status": 200,
        "equals": {
          "route": "담당자 연결"
        },
        "max_seconds": 5
      }
    },
    {
      "name": "캐시에 있으면 FAQ가 멈춰도 답",
      "before": [
        {
          "url": "http://localhost:8800/cache-clear",
          "body": {}
        },
        {
          "webhook": "my-helpdesk",
          "request": "requests/faq-printer.json"
        },
        {
          "url": "http://localhost:8800/admin/fault",
          "body": {
            "faq": "error"
          }
        }
      ],
      "after": [
        {
          "url": "http://localhost:8800/admin/fault",
          "body": {
            "faq": "ok",
            "tickets": "ok"
          }
        }
      ],
      "request": "requests/faq-printer.json",
      "expect": {
        "equals": {
          "route": "자동 답변",
          "cached": true
        }
      }
    }
  ]
}
