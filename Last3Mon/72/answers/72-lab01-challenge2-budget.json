    {
      "name": "Classify",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "parameters": {
        "promptType": "define",
        "text": "={{ $('Question webhook').first().json.body.question }}",
        "options": {
          "systemMessage": "You sort one company IT help-desk question. Categories: faq (how to fix or use something: password, account lock, VPN, printer, mail box, software install), ticket (asks about the status of an IT request ticket like T-1002), other (anything else). Return only JSON, no code fence: {\"category\": \"faq\"}",
          "maxIterations": 1
        }
      },
      "position": [
        660,
        300
      ],
      "id": "7a93b236-dbff-52c5-9397-61087bc0688d"
    },
    {
      "name": "Classify model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "gpt-4.1-mini"
        },
        "options": {
          "temperature": 0
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "openAiCourse0001",
          "name": "OpenAI (.env)"
        }
      },
      "position": [
        660,
        520
      ],
      "id": "357e7611-4597-5ba3-a6ba-9a4d4d63cda7"
    },
    {
      "name": "Parse category",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const raw = String($json.output ?? '').trim().replace(/^```(json)?\\s*|```$/g, '');\nlet category = 'other';\ntry { category = JSON.parse(raw).category ?? 'other'; } catch (error) { category = 'other'; }\nif (!['faq', 'ticket', 'other'].includes(category)) category = 'other';\nreturn [{ json: { category, by: 'llm' } }];"
      },
      "position": [
        880,
        300
      ],
      "id": "9327634c-6764-5403-b7bc-3e666e7ae3d6"
    },
    {
      "name": "After classify",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return [{ json: { ...$json, t: Date.now() } }];"
      },
      "position": [
        1100,
        300
      ],
      "id": "8f3da4f6-ce34-5505-b543-e5d68d990a96"
    },
