    },
    {
      "name": "Review check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "let answer = String($('Answer').first().json.output ?? '').trim();\nconst problems = [];\nif (!answer) problems.push('empty');\nif (!/[가-힣]/.test(answer)) problems.push('not_korean');\nif (answer.length > 400) { answer = answer.slice(0, 400); problems.push('too_long'); }\nreturn [{ json: { ...$json, answer, review_problems: problems } }];"
      },
      "position": [
        3520,
        300
      ],
      "id": "c2d5b0e4-e7e1-5972-8b49-d2aa51694714"
    },
    {
      "name": "After review",
      "type": "n8n-nodes-base.code",
