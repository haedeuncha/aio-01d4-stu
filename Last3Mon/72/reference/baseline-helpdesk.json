    {
      "name": "Classify",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "parameters": {
        "promptType": "define",
        "text": "={{ $('Question webhook').first().json.body.question }}",
        "options": {
          "systemMessage": "You sort one company IT help-desk question. Categories: faq (how to fix or use something: password, account lock, VPN, printer, mail box, software install), ticket (asks about the status of an IT request ticket like T-1002), other (anything else). Return only JSON, no code fence: {\"category\": \"faq\"}",
          "maxIterations": 1
        }
      },
      "position": [
        440,
        300
      ],
      "id": "e44002cd-d810-5fbe-9eef-d0d9e897b974"
    },
    {
