    {
      "name": "Parse actions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "jsCode": "// Both LLM answers arrived. Parse the actions answer.\n// LLM output is text. Read it as JSON; if that fails, treat it as no actions. Then fill the blanks.\nconst raw = String($('Extract actions').first().json.output ?? '').trim().replace(/^```(json)?\\s*|```$/g, '');\nlet data = {};\ntry { data = JSON.parse(raw); } catch (error) { data = {}; }\nconst actions = (Array.isArray(data.actions) ? data.actions : [])\n  .map(item => ({ owner: String(item?.owner ?? '').trim() || '미정', task: String(item?.task ?? '').trim(), due: String(item?.due ?? '').trim() || '미정' }))\n  .filter(item => item.task);\nconst notes = $('Meeting webhook').first().json.body.notes;\nconst heading = notes.match(/(?:^|[\\n.])\\s*(?:참석자?|Attendees)\\s*[:：]\\s*([^\\n.]+)/i);\nconst attendees = heading ? heading[1].split(/[,，、]/).map(name=>name.trim()).filter(Boolean) : [];\nreturn [{ json: { title: (String($('Meeting webhook').first().json.body.title ?? '').trim() || '회의'), summary: $('Summarize').first().json.output.trim(), count: actions.length, actions, attendees } }];"
      }
    },
