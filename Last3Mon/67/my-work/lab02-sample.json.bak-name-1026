            }
          }
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "requester",
              "value": "={{ typeof $('IT question webhook').first().json.body.user === 'string' ? ($('IT question webhook').first().json.body.user.trim() || '__missing_requester__') : '__missing_requester__' }}"
