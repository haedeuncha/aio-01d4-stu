        "toolDescription": "Look up the status of an IT request ticket. Use it only when the question contains a ticket id such as T-1002. Input: the ticket id.",
        "url": "=http://data-api:8800/tickets/{{ encodeURIComponent(String($fromAI('ticket_id', 'Ticket id such as T-1002', 'string')).replace(/\\s/g, '').toUpperCase()) }}",
        "options": {
