      "name": "Get ticket",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [
        540,
        520
      ]
    },
    {
      "parameters": {
        "jsCode": "const body=$('IT question webhook').first().json.body;\nconst steps=Array.isArray($json.intermediateSteps)?$json.intermediateSteps:[];\nconst tools_used=[...new Set(steps.map(s=>s.action?.tool).filter(Boolean))];\nconst faqs=new Map(), tickets=new Map(), errors=[];\nfunction collect(v,tool) {\n if(typeof v==='string'){try{collect(JSON.parse(v),tool)}catch(_){}return;}\n if(Array.isArray(v)){v.forEach(x=>collect(x,tool));return;}\n if(!v||typeof v!=='object')return;\n if(typeof v.error==='string')errors.push(v.error);\n if(tool==='Search_FAQ'&&/^FAQ-\\d+$/.test(v.id??'')&&typeof v.answer==='string')faqs.set(v.id,v);\n if(tool==='Get_ticket'&&/^T-\\d+$/.test(v.ticket_id??'')&&v.requester===body.user?.trim()&&typeof v.status==='string')tickets.set(v.ticket_id,v);\n Object.values(v).forEach(x=>collect(x,tool));\n}\nsteps.forEach(s=>collect(s.observation,s.action?.tool));\nconst ids=[...new Set((body.question.match(/T\\s*-\\s*\\d+/gi)??[]).map(id=>id.replace(/\\s/g,'').toUpperCase()))];\nlet answer=String($json.output??'').trim();\nlet sources=ids.length?[...tickets.keys()]:[...faqs.keys()];\nconst denied=errors.some(e=>/not your ticket/i.test(e));\nconst missing=errors.some(e=>/ticket not found/i.test(e));\nconst found=ids.length?ids.every(id=>tickets.has(id)):faqs.size>0;\nif(denied){answer='본인이 접수한 문의만 조회할 수 있습니다.';sources=[];}\nelse if(missing){answer='접수 번호를 찾지 못했습니다. IT 담당자에게 문의해 주세요.';sources=[];}\nelse if(!found){answer='관련 FAQ를 찾지 못했습니다. IT 담당자에게 문의해 주세요.';sources=[];}\nelse if(ids.length){answer=ids.map(id=>`${id} 접수 상태는 ${tickets.get(id).status}입니다.`).join(' ');}\nreturn [{json:{answer,tools_used,sources}}];"
      },
