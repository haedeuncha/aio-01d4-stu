{
  "webhook": "my-chat",
  "cases": [
    {
      "name": "VPN 질문에 답변",
      "request": "requests/faq-vpn.json",
      "expect": {
        "status": 200,
        "contains": {
          "answer": ["VPN", "vpn", "연결", "네트워크"]
        }
      }
    },
    {
      "name": "IT 외 질문에도 한국어 응답 반환",
      "request": "requests/off-topic.json",
      "expect": {
        "status": 200,
        "contains": {
          "answer": ["다", "요", "까"]
        }
      }
    }
  ]
}
