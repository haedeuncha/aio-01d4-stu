{
  "webhook": "my-it-agent",
  "cases": [
    {"name": "비밀번호 FAQ", "request": "requests/faq-password.json",
     "expect": {"status": 200, "contains": {"answer": "휴대폰", "tools_used": "Search_FAQ"}}},
    {"name": "접수 현황", "request": "requests/ticket-status.json",
     "expect": {"status": 200, "contains": {"answer": "처리 중", "tools_used": "Get_ticket"}}},
    {"name": "없는 접수 번호", "request": "requests/ticket-missing.json",
     "expect": {"status": 200, "contains": {"answer": ["찾지 못", "없", "존재하지"], "tools_used": "Get_ticket"}}},
    {"name": "모르면 모른다고", "request": "requests/off-topic.json",
     "expect": {"status": 200, "contains": {"answer": "찾지 못했습니다"}}}
  ]
}
