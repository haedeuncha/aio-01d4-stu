      "parameters": {
        "promptType": "define",
        "text": "=질문: {{ $json.question }}\n\n규정 발췌:\n{{ $json.context }}",
        "options": {
          "systemMessage": "Answer the employee's question only from the numbered policy excerpts, in Korean, in at most 3 sentences. After each fact, write the number of the excerpt it came from in square brackets, such as [2]. If the excerpts do not contain the answer, answer exactly: 규정에서 답을 찾지 못했습니다.",
          "maxIterations": 2
        }
      }
    },
    {
      "name": "OpenAI chat model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        1040,
        420
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "gpt-4.1-mini"
        },
        "options": {
          "temperature": 0
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "openAiCourse0001",
          "name": "OpenAI (.env)"
        }
      }
    },
    {
      "name": "Build answer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        200
      ],
      "parameters": {
        "jsCode": "// Turn excerpt numbers into document titles and keep which documents were cited.\nconst ctx = $('Build context').first().json;\nconst draft = String($json.output ?? '').trim();\nconst numbers = [...draft.matchAll(/\\[(\\d+)\\]/g)].map(m => Number(m[1])).filter(n => n >= 1 && n <= ctx.hits.length);\nconst cited = [...new Set(numbers.map(n => ctx.hits[n - 1].source))];\nconst answer = draft.replace(/\\[(\\d+)\\]/g, (all, n) => ctx.hits[n - 1] ? `[${ctx.hits[n - 1].title}]` : all);\nconst bigrams = s => { const t = s.replace(/\\s+/g, ''); const set = new Set(); for (let i = 0; i < t.length - 1; i++) set.add(t.slice(i, i + 2)); return set; };\nconst overlap = (a, b) => { const A = bigrams(a); if (!A.size) return 0; const B = bigrams(b); let n = 0; for (const x of A) if (B.has(x)) n++; return n / A.size; };\nconst plain = draft.replace(/\\[\\d+\\]/g, '');\nconst numbersInAnswer = plain.match(/\\d+/g) ?? [];\nconst checks = [\n  // The LLM says \"not found\" in many ways even when told the exact sentence.\n  { name: 'found_in_policies', passed: !/찾지 못했|포함되어 있지 않|명시되어 있지 않|언급이 없|나와 있지 않/.test(draft) },\n  { name: 'cites_excerpt', passed: cited.length > 0 },\n  { name: 'grounded', passed: overlap(plain, ctx.context) >= 0.3 },\n  { name: 'numbers_from_policies', passed: numbersInAnswer.every(n => ctx.context.includes(n)) },\n];\nconst failed = checks.filter(check => !check.passed).map(check => check.name);\nreturn [{ json: { route: failed.length ? '담당자 연결' : '자동 답변', answer: failed.length ? '규정에서 확실한 답을 찾지 못해 IT 담당자에게 전달했습니다.' : answer, draft: answer, sources: [...new Set(ctx.hits.map(hit => hit.source))], cited, top_score: ctx.top_score, checks, failed } }];"
      }
    },
