{
  "name": "71-2 · 🔎 규정 검색 (my-search)",
  "nodes": [
    {
      "name": "Search webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "my-search",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "name": "Has question?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.body.question }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "name": "Rewrite query",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        460,
        200
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.body.question }}",
        "options": {
          "systemMessage": "Rewrite one employee question into a short Korean search query (under 12 words) in the wording of company IT policy documents.\nReturn only the query, one line, no quotes, no explanation.\n- Turn casual words, slang and product names into the general policy term for the SAME thing\n  (비번 → 비밀번호, 컴 → 컴퓨터, 폰 → 휴대폰, 깔다 → 설치, 그만두다 → 퇴사, 챗GPT·제미나이 → 생성형 AI 서비스).\n- Translate only what the question says. Never add a topic, action or term the question does not mention.\n- Keep numbers and names. Do not answer the question.\nExamples:\n비번 몇 자로 만들어야 돼? → 비밀번호 만들기 최소 글자 수\n그만두면 노트북 언제 돌려줘? → 퇴사 장비 반납 기한\n회사 컴에 프로그램 깔아도 돼? → 업무용 컴퓨터 소프트웨어 설치 승인\n챗GPT 업무에 써도 돼요? → 생성형 AI 서비스 업무 사용",
          "maxIterations": 2
        }
      }
    },
    {
      "name": "OpenAI chat model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        420,
        440
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "gpt-4.1-mini"
        },
        "options": {
          "temperature": 0
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "openAiCourse0001",
          "name": "OpenAI (.env)"
        }
      }
    },
    {
      "name": "Search policies",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreInMemory",
      "typeVersion": 1.3,
      "position": [
        720,
        200
      ],
      "parameters": {
        "mode": "load",
        "memoryKey": {
          "__rl": true,
          "mode": "list",
          "value": "my_policy_docs",
          "cachedResultName": "my_policy_docs"
        },
        "prompt": "={{ $json.output || $('Search webhook').first().json.body.question }}",
        "topK": "={{ $('Search webhook').first().json.body.top_k ?? 3 }}",
        "includeDocumentMetadata": true
      },
      "alwaysOutputData": true
    },
    {
      "name": "Embeddings",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2,
      "position": [
        720,
        440
      ],
      "parameters": {
        "model": "text-embedding-3-large",
        "options": {}
      },
      "credentials": {
        "openAiApi": {
          "id": "openAiCourse0001",
          "name": "OpenAI (.env)"
        }
      }
    },
    {
      "name": "Format hits",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        200
      ],
      "parameters": {
        "jsCode": "// 저장소가 비면 빈 항목 하나가 오므로 document 가 있는 항목만 쓴다\nconst question = $('Search webhook').first().json.body.question;\nconst hits = $input.all()\n  .filter(item => item.json.document)\n  .map((item, i) => {\n    const meta = item.json.document.metadata || {};\n    return {\n      rank: i + 1,\n      source: meta.source || '',\n      title: meta.title || '',\n      section: meta.section || '',\n      score: Math.round((item.json.score ?? 0) * 1000) / 1000,\n      text: item.json.document.pageContent,\n    };\n  });\nconst query = String($('Rewrite query').first().json.output || question).trim();\nreturn [{ json: { question, query, hits, top_score: hits.length ? hits[0].score : 0, indexed: hits.length > 0 } }];"
      }
    },
    {
      "name": "Send result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1180,
        200
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      }
    },
    {
      "name": "Reject empty",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        460,
        640
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{ \"error\": \"question is required\" }",
        "options": {
          "responseCode": 400
        }
      }
    }
  ],
  "connections": {
