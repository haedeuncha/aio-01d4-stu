{
  "name": "71-1 · 📚 규정 색인 (my-index)",
  "nodes": [
    {
      "name": "Index webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "my-index",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "name": "List docs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "url": "http://data-api:8800/docs",
        "options": {}
      }
    },
    {
      "name": "One item per doc",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        440,
        300
      ],
      "parameters": {
        "fieldToSplitOut": "docs",
        "options": {}
      }
    },
    {
      "name": "Get doc",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "url": "=http://data-api:8800/docs/{{ $json.name }}",
        "options": {}
      }
    },
    {
      "name": "Make chunks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "jsCode": "// 청크 나누기: chunking = \"section\"(기본) 이면 \"## \" 섹션마다, 숫자면 그 글자 수마다\nconst body = $('Index webhook').first().json.body || {};\nconst size = Number(body.chunking);\nconst bySize = Number.isFinite(size) && size > 0;\nconst chunks = [];\nfor (const item of $input.all()) {\n  const { name, title, text } = item.json;\n  if (bySize) {\n    const content = text.replace(/^# .*\\n+/, '').trim();\n    for (let i = 0, n = 1; i < content.length; i += size, n++) {\n      chunks.push({ json: { source: name, title, chunk: n, text: `${title}\\n${content.slice(i, i + size)}` } });\n    }\n  } else {\n    text.split(/\\n(?=## )/).slice(1).forEach((piece, i) => {\n      const section = piece.match(/^## (.*)/)[1].trim();\n      chunks.push({ json: { source: name, title, section, chunk: i + 1, text: `${title}\\n${piece.trim()}` } });\n    });\n  }\n}\nreturn chunks;"
      }
    },
    {
      "name": "Store chunks",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreInMemory",
      "typeVersion": 1.3,
      "position": [
        1120,
        300
      ],
      "parameters": {
        "mode": "insert",
        "memoryKey": {
          "__rl": true,
          "mode": "list",
          "value": "my_policy_docs",
          "cachedResultName": "my_policy_docs"
        },
        "clearStore": true
      }
    },
    {
      "name": "Embeddings",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2,
      "position": [
        1260,
        520
      ],
      "parameters": {
        "model": "text-embedding-3-large",
        "options": {}
      },
      "credentials": {
        "openAiApi": {
          "id": "openAiCourse0001",
          "name": "OpenAI (.env)"
        }
      }
    },
    {
      "name": "Chunk loader",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1.1,
      "position": [
        1420,
        520
      ],
      "parameters": {
        "jsonMode": "expressionData",
        "jsonData": "={{ $json.text }}",
        "textSplittingMode": "simple",
        "options": {
          "metadata": {
            "metadataValues": [
              {
                "name": "source",
                "value": "={{ $json.source }}"
              },
              {
                "name": "title",
                "value": "={{ $json.title }}"
              },
              {
                "name": "section",
                "value": "={{ $json.section ?? '' }}"
              },
              {
                "name": "chunk",
                "value": "={{ $json.chunk }}"
              }
            ]
          }
        }
      }
    },
    {
      "name": "Count chunks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1420,
        300
      ],
      "parameters": {
        "jsCode": "const body = $('Index webhook').first().json.body || {};\nconst size = Number(body.chunking);\nreturn [{ json: {\n  indexed_chunks: $('Make chunks').all().length,\n  chunking: Number.isFinite(size) && size > 0 ? size : 'section',\n} }];"
      }
    },
    {
      "name": "Send result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1640,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      }
    }
  ],
  "connections": {
