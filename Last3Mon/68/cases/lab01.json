{
  "webhook": "my-split",
  "cases": [
    {
      "name": "복합 요청 · 업무 3개",
      "request": "requests/composite.json",
      "expect": {
        "equals": {
          "count": 3
        },
        "contains": {
          "tasks": [
            "\"type\": \"meeting\""
          ],
          "tasks.0.text": [
            "T-1002"
          ]
        }
      }
    },
    {
      "name": "IT 하나",
      "request": "requests/it-only.json",
      "expect": {
        "equals": {
          "count": 1,
          "tasks.0.type": "it"
        }
      }
    },
    {
      "name": "IT 둘",
      "request": "requests/two-it.json",
      "expect": {
        "equals": {
          "count": 2,
          "tasks.0.type": "it",
          "tasks.1.type": "it"
        }
      }
    },
    {
      "name": "회의록 정리",
      "request": "requests/meeting-only.json",
      "expect": {
        "equals": {
          "count": 1,
          "tasks.0.type": "meeting"
        }
      }
    },
    {
      "name": "IT와 기타",
      "request": "requests/it-and-other.json",
      "expect": {
        "equals": {
          "count": 2,
          "tasks.0.type": "it",
          "tasks.1.type": "other"
        }
      }
    },
    {
      "name": "기타만",
      "request": "requests/other-only.json",
      "expect": {
        "equals": {
          "count": 1,
          "tasks.0.type": "other"
        }
      }
    },
    {
      "name": "빈 요청",
      "request": "requests/empty-message.json",
      "expect": {
        "status": 400
      }
    }
  ]
}
