    {
      "name": "Look up balance",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        925,
        300
      ],
      "parameters": {
        "jsCode": "const body = $('Balance webhook').first().json.body;\n// 연습용 가짜 인사 데이터 (2026년)\nconst LEAVE = { '박서연': { total: 15, used: 6 }, '이준호': { total: 15, used: 14.5 }, '김민지': { total: 20, used: 3 } };\nconst user = String(body.user).trim();\nconst target = String(body.target ?? '').replace(/\\s*(님|씨)$/, '').trim() || user;\n// 권한 검사는 라우터를 믿지 않고 여기서 한다: 본인 것만\nif (target !== user) return [{ json: { route: '담당자 연결', answer: `다른 직원(${target})의 연차는 본인과 인사팀만 볼 수 있어 인사팀에 연결했습니다.`, user } }];\nconst row = LEAVE[user];\nif (!row) return [{ json: { route: '담당자 연결', answer: `${user} 님의 연차 기록을 찾지 못해 인사팀에 연결했습니다.`, user } }];\nconst remaining = row.total - row.used;\nreturn [{ json: { route: '자동 답변', answer: `${user} 님의 남은 연차는 ${remaining}일입니다 (올해 ${row.total}일 중 ${row.used}일 사용). 남은 연차는 다음 해로 최대 5일까지 넘길 수 있어요 (HR-5).`,\n  user, total: row.total, used: row.used, remaining } }];"
      }
    },
    {
