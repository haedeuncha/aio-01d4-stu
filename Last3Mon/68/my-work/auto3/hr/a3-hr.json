    {
      "name": "Parse tasks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1365,
        400
      ],
      "parameters": {
        "jsCode": "const body = $('HR webhook').first().json.body;\nconst user = String(body.user).trim();\nconst today = $now.setZone('Asia/Seoul').toFormat('yyyy-MM-dd');\nconst isDate = s => typeof s === 'string' && /^\\d{4}-\\d{2}-\\d{2}$/.test(s) && !isNaN(Date.parse(s + 'T00:00:00Z')) && new Date(s + 'T00:00:00Z').toISOString().slice(0, 10) === s;\nconst dayKo = s => '일월화수목금토'[new Date(s + 'T00:00:00Z').getUTCDay()];\nconst addDays = (s, n) => new Date(Date.parse(s + 'T00:00:00Z') + n * 86400000).toISOString().slice(0, 10);\nconst daysBetween = (a, b) => Math.round((Date.parse(b + 'T00:00:00Z') - Date.parse(a + 'T00:00:00Z')) / 86400000);\n// LLM이 날짜를 지어내지 않았는지: 요청 문장에 날짜를 말하는 표현이 있어야 날짜를 믿는다\nconst mentionsDate = text => /\\d{1,2}\\s*월|\\d{1,2}\\s*일|\\d{4}-\\d{1,2}-\\d{1,2}|\\d{1,2}\\/\\d{1,2}|오늘|내일|모레|글피|요일|이번\\s*주|다음\\s*주|주말|월말|월초/.test(String(text ?? ''));\nconst range = (a, b) => (!b || a === b) ? `${a}(${dayKo(a)})` : `${a}(${dayKo(a)}) ~ ${b}(${dayKo(b)})`;\nfunction parseJson(output) {\n  const raw = String(output ?? '');\n  const start = raw.indexOf('{');\n  const end = raw.lastIndexOf('}');\n  if (start < 0 || end < start) throw new Error('no JSON');\n  return JSON.parse(raw.slice(start, end + 1));\n}\nconst AGENT = { balance: 'a3-hr-balance', leave: 'a3-hr-leave', policy: 'a3-hr-policy', other: '담당자 연결' };\ntry {\n  const parsed = parseJson($json.output);\n  if (!Array.isArray(parsed.tasks)) throw new Error('no tasks');\n  const tasks = parsed.tasks\n    .filter(t => t && typeof t.text === 'string' && t.text.trim())\n    .map(t => {\n      const type = AGENT[t.type] ? t.type : 'other';\n      const task = { type, text: t.text.trim(), agent: AGENT[type], missing: [], ask: '' };\n      if (type === 'balance') {\n        const target = String(t.target ?? '').replace(/\\s*(님|씨)$/, '').trim();\n        task.target = target === user ? '' : target;\n      }\n      if (type === 'leave') {\n        const said = mentionsDate(body.message);\n        task.start = said && isDate(t.start) ? t.start : '';\n        task.end = said && isDate(t.end) ? t.end : '';\n        task.kind = String(t.kind ?? '').includes('반차') ? '반차' : '연차';\n        task.half = ['오전', '오후'].includes(t.half) ? t.half : '';\n        if (!task.start) { task.missing.push('날짜'); task.ask = '언제 쉬실지 날짜를 알려 주세요. 예: \"11월 6일 연차\", \"11월 10일부터 11일까지 연차\"'; }\n      }\n      task.lane = task.missing.length ? 'needs input' : type;\n      return task;\n    });\n  return [{ json: { count: tasks.length, tasks } }];\n} catch (error) {\n  return [{ json: { count: 0, tasks: [], error: 'split_failed' } }];\n}"
      }
    },
