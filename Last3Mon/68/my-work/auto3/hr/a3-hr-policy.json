    {
      "name": "Reject missing",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        495,
        520
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"error\": \"question is required\", \"hint\": \"예: {\\\"question\\\": \\\"병가 쓰려면 진단서 필요해?\\\", \\\"user\\\": \\\"박서연\\\"}\"}",
