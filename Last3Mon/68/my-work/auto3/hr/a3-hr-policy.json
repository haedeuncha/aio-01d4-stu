    {
      "name": "Find rules",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        925,
        300
      ],
      "parameters": {
        "jsCode": "const body = $('Policy webhook').first().json.body;\nconst won = n => Math.round(n).toString().replace(/\\B(?=(\\d{3})+(?!\\d))/g, ',') + '원';\nconst hash = s => { let h = 5381; for (const c of s) h = ((h * 33) ^ c.codePointAt(0)) >>> 0; return h.toString(36).toUpperCase().slice(-4).padStart(4, '0'); };\nconst RULES = [\n {\n  \"id\": \"HR-1\",\n  \"title\": \"연차 신청 기한\",\n  \"text\": \"연차·반차는 사용일 3일 전까지 신청한다.\",\n  \"keywords\": [\n   \"신청\",\n   \"미리\",\n   \"며칠 전\",\n   \"기한\",\n   \"언제까지\"\n  ]\n },\n {\n  \"id\": \"HR-2\",\n  \"title\": \"반차\",\n  \"text\": \"반차는 0.5일로 계산한다. 오전 반차 9~13시, 오후 반차 14~18시.\",\n  \"keywords\": [\n   \"반차\",\n   \"오전\",\n   \"오후\",\n   \"반일\"\n  ]\n },\n {\n  \"id\": \"HR-3\",\n  \"title\": \"병가\",\n  \"text\": \"병가는 연 3일까지 유급이다. 2일 이상 연속으로 쓰면 진단서를 낸다.\",\n  \"keywords\": [\n   \"병가\",\n   \"아파\",\n   \"아플\",\n   \"진단서\",\n   \"병원\"\n  ]\n },\n {\n  \"id\": \"HR-4\",\n  \"title\": \"경조휴가\",\n  \"text\": \"본인 결혼 5일, 부모·배우자 사망 5일, 조부모 사망 3일, 자녀 결혼 1일. 연차에서 빼지 않는다.\",\n  \"keywords\": [\n   \"경조\",\n   \"결혼\",\n   \"사망\",\n   \"장례\",\n   \"조부모\",\n   \"부고\"\n  ]\n },\n {\n  \"id\": \"HR-5\",\n  \"title\": \"연차 이월\",\n  \"text\": \"남은 연차는 다음 해로 최대 5일까지 넘길 수 있다.\",\n  \"keywords\": [\n   \"이월\",\n   \"넘겨\",\n   \"넘어\",\n   \"넘길\",\n   \"내년\"\n  ]\n }\n];\nconst question = String(body.question).trim();\nconst q = question.replace(/\\s+/g, ' ');\nconst matched = RULES.map(r => ({ ...r, score: r.keywords.filter(k => q.includes(k)).length }))\n  .filter(r => r.score > 0).sort((a, b) => b.score - a.score).slice(0, 3)\n  .map(({ id, title, text }) => ({ id, title, text }));\nconst facts = '';\nreturn [{ json: { question, rules: matched, facts, found: matched.length > 0 } }];"
      }
    },
