{
  "webhook": "a3-content",
  "cases": [
    {
      "name": "복합 3개 · 소개글→SNS→일정",
      "body": {
        "message": "신제품 소개글 써 주고, 인스타랑 X용으로 줄여 줘. 11월 2일에 올리게 일정도 잡아 줘.",
        "user": "김민지",
        "product": {
          "name": "루미 무선 이어폰",
          "price": 89000,
          "features": [
            "노이즈 캔슬링",
            "30시간 재생",
            "IPX5 방수"
          ]
        }
      },
      "expect": {
        "equals": {
          "count": 3,
          "results.0.agent": "a3-copy",
          "results.1.agent": "a3-sns",
          "results.2.route": "등록 완료"
        },
        "contains": {
          "results.0.answer": [
            "루미"
          ],
          "results.1.answer": [
            "instagram"
          ],
          "results.2.answer": [
            "신제품 발표"
          ]
        }
      }
    },
    {
      "name": "가격 없으면 가격 안 씀",
      "body": {
        "message": "소개글 써 줘",
        "user": "김민지",
        "product": {
          "name": "루미 무선 이어폰",
          "features": [
            "노이즈 캔슬링"
          ]
        }
      },
      "expect": {
        "equals": {
          "count": 1,
          "results.0.route": "자동 답변"
        },
        "not_contains": {
          "results.0.answer": [
            "000원",
            "할인",
            "%"
          ]
        }
      }
    },
    {
      "name": "SNS만 · 원문 있음",
      "body": {
        "message": "이 글 인스타용으로 줄여 줘",
        "user": "김민지",
        "text": "루미 무선 이어폰은 노이즈 캔슬링으로 주변 소음을 줄여 음악에 집중하게 해 줍니다. 한 번 충전으로 30시간 재생되어 출퇴근과 여행에도 넉넉하고, IPX5 방수라 운동할 때도 걱정 없어요. 가격은 89,000원입니다. 매일 함께할 이어폰으로 루미를 만나 보세요."
      },
      "expect": {
        "equals": {
          "count": 1,
          "results.0.agent": "a3-sns",
          "results.0.route": "자동 답변"
        }
      }
    },
    {
      "name": "제품 정보 없음 · 입력 필요",
      "body": {
        "message": "소개글 써 줘",
        "user": "김민지"
      },
      "expect": {
        "equals": {
          "count": 1,
          "results.0.route": "입력 필요"
        }
      }
    },
    {
      "name": "범위 밖 · 광고비",
      "body": {
        "message": "광고비 100만 원 집행해 줘",
        "user": "김민지"
      },
      "expect": {
        "equals": {
          "results.0.route": "담당자 연결"
        }
      }
    },
    {
      "name": "게시 날짜 없음 · 입력 필요",
      "body": {
        "message": "게시 일정 잡아 줘",
        "user": "김민지"
      },
      "expect": {
        "equals": {
          "count": 1,
          "results.0.route": "입력 필요"
        }
      }
    },
    {
      "name": "빈 요청 · 400",
      "body": {
        "message": "",
        "user": "김민지"
      },
      "expect": {
        "status": 400
      }
    }
  ]
}