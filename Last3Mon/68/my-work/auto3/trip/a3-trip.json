    {
      "name": "Build reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4805,
        400
      ],
      "parameters": {
        "jsCode": "const results = [...($json.results ?? [])].sort((a, b) => a.index - b.index);\nconst user = String($('Trip webhook').first().json.body.user ?? '').trim();\nconst ICON = { '자동 답변': '✅', '접수 완료': '📝', '등록 완료': '📅', '거절': '⛔', '입력 필요': '❓', '담당자 연결': '🙋' };\nconst oneLine = value => String(value ?? '').replace(/\\s+/g, ' ').trim();\n// 여러 줄 답(SNS 채널별 글)은 줄을 살려 들여 쓴다\nconst block = value => String(value ?? '').split('\\n').map(oneLine).filter(Boolean).join('\\n   ');\nconst lines = results.map(r => `${r.index}. ${ICON[r.route] ?? '•'} [${r.route}] ${block(r.answer)}`);\nconst ask = results.filter(r => r.route === '입력 필요').map(r => r.index);\nconst handed = results.filter(r => r.route === '담당자 연결').map(r => r.index);\nconst tail = [];\nif (ask.length) tail.push(`❓ ${ask.join(', ')}번은 필요한 정보를 알려 주시면 바로 처리할게요.`);\nif (handed.length) tail.push(`🙋 ${handed.join(', ')}번은 담당자가 이어서 연락드립니다.`);\nconst reply = [`${user} 님, 요청하신 ${results.length}가지를 정리했어요.`, ...lines, ...tail].join('\\n');\nreturn [{ json: { count: results.length, results, reply } }];"
      }
    },
