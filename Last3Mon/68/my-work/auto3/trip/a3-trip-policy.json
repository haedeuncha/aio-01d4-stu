      "credentials": {
        "openAiApi": {
          "id": "openAiCourse0001",
          "name": "OpenAI (.env)"
        }
      }
    },
    {
      "name": "Build answer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2225,
        220
      ],
      "parameters": {
        "jsCode": "function parseJson(output) {\n  const raw = String(output ?? '');\n  const start = raw.indexOf('{');\n  const end = raw.lastIndexOf('}');\n  if (start < 0 || end < start) throw new Error('no JSON');\n  return JSON.parse(raw.slice(start, end + 1));\n}\nconst found = $('Find rules').first().json;\nlet data = {};\ntry { data = parseJson($json.output); } catch (error) { data = {}; }\nconst answer = String(data.answer ?? '').trim();\nif (data.answered !== true || !answer) return [{ json: { route: '담당자 연결', answer: '규정에서 정확한 답을 찾지 못해 총무팀 담당자에게 연결했습니다.', sources: [] } }];\nreturn [{ json: { route: '자동 답변', answer, sources: found.rules.map(r => r.id) } }];"
      }
    },
    {
      "name": "Send result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
