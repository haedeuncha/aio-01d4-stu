    {
      "name": "Find rules",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        925,
        300
      ],
      "parameters": {
        "jsCode": "const body = $('Policy webhook').first().json.body;\nconst won = n => Math.round(n).toString().replace(/\\B(?=(\\d{3})+(?!\\d))/g, ',') + '원';\nconst hash = s => { let h = 5381; for (const c of s) h = ((h * 33) ^ c.codePointAt(0)) >>> 0; return h.toString(36).toUpperCase().slice(-4).padStart(4, '0'); };\nconst RULES = [\n {\n  \"id\": \"TR-1\",\n  \"title\": \"숙박 한도 (1박)\",\n  \"text\": \"서울 120,000원, 부산·대구·광주·대전·인천·울산 100,000원, 그 밖 80,000원.\",\n  \"keywords\": [\n   \"숙박\",\n   \"숙소\",\n   \"호텔\",\n   \"묵\",\n   \"방값\",\n   \"1박\"\n  ]\n },\n {\n  \"id\": \"TR-2\",\n  \"title\": \"일비\",\n  \"text\": \"하루 30,000원 (출발일·도착일 포함).\",\n  \"keywords\": [\n   \"일비\",\n   \"식비\",\n   \"식대\",\n   \"밥\",\n   \"수당\",\n   \"하루\"\n  ]\n },\n {\n  \"id\": \"TR-3\",\n  \"title\": \"교통\",\n  \"text\": \"KTX 일반실·고속버스는 실비. 교통비를 모르면 0원으로 신청하고 나중에 영수증으로 정산한다.\",\n  \"keywords\": [\n   \"교통\",\n   \"KTX\",\n   \"기차\",\n   \"버스\",\n   \"비행기\",\n   \"항공\",\n   \"차비\",\n   \"자가용\"\n  ]\n },\n {\n  \"id\": \"TR-4\",\n  \"title\": \"결재\",\n  \"text\": \"7박 초과 또는 총액 100만 원 초과면 팀장 결재가 필요하다.\",\n  \"keywords\": [\n   \"결재\",\n   \"승인\",\n   \"팀장\",\n   \"장기\",\n   \"오래\"\n  ]\n },\n {\n  \"id\": \"TR-5\",\n  \"title\": \"정산\",\n  \"text\": \"복귀 후 5일 안에 영수증을 제출한다.\",\n  \"keywords\": [\n   \"정산\",\n   \"영수증\",\n   \"제출\",\n   \"증빙\"\n  ]\n }\n];\nconst question = String(body.question).trim();\nconst q = question.replace(/\\s+/g, ' ');\nconst matched = RULES.map(r => ({ ...r, score: r.keywords.filter(k => q.includes(k)).length }))\n  .filter(r => r.score > 0).sort((a, b) => b.score - a.score).slice(0, 3)\n  .map(({ id, title, text }) => ({ id, title, text }));\nconst TIER = { '서울': 120000, '부산': 100000, '대구': 100000, '광주': 100000, '대전': 100000, '인천': 100000, '울산': 100000 };\nconst city = String(body.city ?? '').trim().replace(/(특별시|광역시|시)$/, '');\nconst facts = city ? `${city} 숙박 한도 1박 ${won(TIER[city] ?? 80000)}, 일비 하루 ${won(30000)}` : '';\nif (city && !matched.some(r => r.id === 'TR-1') && /숙|호텔|묵/.test(q)) matched.unshift(RULES[0]);\nreturn [{ json: { question, rules: matched, facts, found: matched.length > 0 } }];"
      }
    },
