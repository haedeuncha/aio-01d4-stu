    {
      "name": "Parse tasks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        840,
        300
      ],
      "parameters": {
        "jsCode": "// 1) LLM 답을 읽어 업무 목록 만들기 (LLM을 그대로 믿지 않음)\n// 2) 담당 Agent와 빠진 입력은 LLM이 아니라 규칙(아래 표)으로 정함\nconst body = $('Assistant webhook').first().json.body || {};\nconst AGENT_BY_TYPE = { it: 'it-agent', meeting: 'meeting-agent', other: '담당자 연결' };\nconst isEmpty = (v) => typeof v !== 'string' || v.trim().length === 0;\nfunction missingFor(type) {\n  const missing = [];\n  if (type === 'it' && isEmpty(body.user)) missing.push('user');\n  if (type === 'meeting' && isEmpty(body.notes)) missing.push('notes');  // 회의록 원문이 없으면\n  return missing;\n}\ntry {\n  const output = $json.output;\n  if (typeof output !== 'string') throw new Error('Invalid output');\n  const start = output.indexOf('{');\n  const end = output.lastIndexOf('}');\n  if (start < 0 || end < start) throw new Error('Missing JSON object');\n  const parsed = JSON.parse(output.slice(start, end + 1));\n  if (!parsed || !Array.isArray(parsed.tasks)) throw new Error('Invalid tasks');\n  const allowedTypes = new Set(['it', 'meeting', 'other']);\n  const tasks = parsed.tasks\n    .filter(task => task && typeof task.text === 'string' && task.text.trim().length > 0)\n    .map(task => {\n      const type = allowedTypes.has(task.type) ? task.type : 'other';\n      return { type, text: task.text.trim(), agent: AGENT_BY_TYPE[type], missing: missingFor(type) };\n    });\n  return [{ json: { count: tasks.length, tasks } }];\n} catch (error) {\n  return [{ json: { count: 0, tasks: [], error: 'split_failed' } }];\n}"
      }
    },
    {
      "name": "One item per task",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "jsCode": "return $json.tasks.map((task, index) => ({ json: { ...task, index: index + 1 } }));"
      }
    },
