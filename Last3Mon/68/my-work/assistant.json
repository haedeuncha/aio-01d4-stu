    {
      "name": "Build reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2760,
        300
      ],
      "parameters": {
        "jsCode": "const results = [...($json.results ?? [])].sort((a, b) => a.index - b.index);\n// Keep each task on one reply line even when an Agent returns multiline text.\nconst oneLine = value => String(value ?? '').replace(/\\s+/g, ' ').trim();\nconst lines = results.map(r => `${r.index}. ${oneLine(r.text)} → [${oneLine(r.route)}] ${oneLine(r.answer)}`);\nreturn [{ json: { count: results.length, results, reply: lines.join('\\n') } }];"
      }
    },
