      "id": "d084b606-aad9-5341-98cd-490070f907ac",
      "name": "LLM classify",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        -40
      ],
      "credentials": {
        "openAiApi": {
          "id": "openAiCourse0001",
          "name": "OpenAI (.env)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// 1) Clean up the LLM label  2) Search the FAQ list\nconst allowed = ['account', 'network', 'device', 'software', 'other'];\nconst raw = String($input.first().json.choices?.[0]?.message?.content ?? '').trim().toLowerCase();\nconst category = allowed.find(a => raw.includes(a)) ?? 'other';\n\nconst faqs = [\n  {\n    \"id\": \"FAQ-001\",\n    \"title\": \"비밀번호 재설정\",\n    \"keywords\": [\n      \"비밀번호\",\n      \"패스워드\",\n      \"password\",\n      \"재설정\",\n      \"초기화\"\n    ],\n    \"answer\": \"사내 포털 로그인 화면의 '비밀번호 찾기'에서 휴대폰 인증 후 새 비밀번호를 설정합니다.\"\n  },\n  {\n    \"id\": \"FAQ-002\",\n    \"title\": \"계정 잠김 해제\",\n    \"keywords\": [\n      \"계정\",\n      \"잠김\",\n      \"잠금\",\n      \"로그인\",\n      \"실패\"\n    ],\n    \"answer\": \"로그인 5회 실패 시 30분 동안 잠깁니다. 30분 후 다시 시도하거나 헬프데스크에 잠금 해제를 요청합니다.\"\n  },\n  {\n    \"id\": \"FAQ-003\",\n    \"title\": \"VPN 접속 오류\",\n    \"keywords\": [\n      \"vpn\",\n      \"원격\",\n      \"재택\",\n      \"접속\",\n      \"연결\"\n    ],\n    \"answer\": \"VPN 클라이언트를 최신 버전으로 업데이트하고, 인증서 만료 여부를 확인한 뒤 다시 접속합니다.\"\n  },\n  {\n    \"id\": \"FAQ-004\",\n    \"title\": \"프린터 출력 안 됨\",\n    \"keywords\": [\n      \"프린터\",\n      \"출력\",\n      \"인쇄\",\n      \"용지\"\n    ],\n    \"answer\": \"프린터 전원과 네트워크 연결을 확인하고, 인쇄 대기열을 비운 뒤 다시 출력합니다.\"\n  },\n  {\n    \"id\": \"FAQ-005\",\n    \"title\": \"메일함 용량 초과\",\n    \"keywords\": [\n      \"메일\",\n      \"용량\",\n      \"메일함\",\n      \"첨부\"\n    ],\n    \"answer\": \"오래된 메일과 큰 첨부 파일을 보관함으로 옮기거나 삭제해 용량을 확보합니다.\"\n  },\n  {\n    \"id\": \"FAQ-006\",\n    \"title\": \"소프트웨어 설치 요청\",\n    \"keywords\": [\n      \"설치\",\n      \"소프트웨어\",\n      \"프로그램\",\n      \"라이선스\"\n    ],\n    \"answer\": \"IT 포털의 '소프트웨어 신청' 메뉴에서 승인 요청을 올리면 승인 후 원격으로 설치됩니다.\"\n  }\n];\nconst settings = $('Settings').first().json;\nconst words = String(settings.text).toLowerCase().split(/\\s+/).filter(w => w.length > 1);\nconst scored = faqs\n  .map(f => ({ ...f, score: words.filter(w => f.keywords.some(k => w.includes(k) || k.includes(w))).length }))\n  .filter(f => f.score > 0)\n  .sort((a, b) => b.score - a.score);\nconst faq = scored[0] ?? null;\n\nreturn [{ json: { user: settings.user, text: settings.text, raw_label: raw, category, found: faq !== null, faq } }];"
      },
