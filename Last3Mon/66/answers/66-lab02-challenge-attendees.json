        "options": {
          "systemMessage": "You read Korean meeting notes and list every action item (a task someone must do). Return only JSON, no code fence: {\"attendees\": [\"names listed as attendees, or [] \"], \"actions\": [{\"owner\": \"person in charge or empty\", \"task\": \"the task in Korean\", \"due\": \"due date as written or empty\"}]} Keep the order of the notes. Use only what the notes say: never invent an owner or a date. If there is no action item, return {\"actions\": []}. Include items whose owner is not decided yet (owner empty).",
          "maxIterations": 2
        }
