      ],
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "actions",
        "options": {}
      }
    },
    {
      "name": "Build report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2040,
        200
      ],
      "parameters": {
        "jsCode": "// One report: the summary, the checked actions and how many need a person to confirm.\nconst actions = $input.all().length && $input.first().json.actions ? $input.first().json.actions : [];\nconst parsed = $('Parse actions').first().json;\nreturn [{ json: { title: parsed.title, summary: parsed.summary, count: actions.length, actions,\n  needs_check_count: actions.filter(action => action.needs_check).length, attendees: parsed.attendees } }];"
      }
    },
