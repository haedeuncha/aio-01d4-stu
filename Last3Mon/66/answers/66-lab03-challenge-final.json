              "type": "string"
            },
            {
              "id": "a3",
              "name": "needs_check",
              "value": "={{ $json.owner === '미정' || $json.due === '미정' }}",
              "type": "boolean"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "name": "Collect actions",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        1820,
