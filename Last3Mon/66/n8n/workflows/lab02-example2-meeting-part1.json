    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Settings').first().json.llm_url }}/chat/completions",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: $('Settings').first().json.model,\n  temperature: 0,\n  response_format: { type: 'json_schema', json_schema: { name: 'reply', schema: {\n    type: 'object',\n    properties: {\n      actions: { type: 'array', items: { type: 'object',\n        properties: { task: { type: 'string' }, owner: { type: 'string' }, due: { type: 'string' } },\n        required: ['task', 'owner', 'due'] } },\n    },\n    required: ['actions'],\n  } } },\n  messages: [\n    { role: 'system', content: \"Extract action items from the meeting notes. Answer in JSON: {\\\"actions\\\": [{\\\"task\\\": str, \\\"owner\\\": str, \\\"due\\\": str}]}. Write task in Korean. Use \\\"미정\\\" when the owner or due date is not stated. Return {\\\"actions\\\": []} when there is no action item.\" },\n    { role: 'user', content: $('Settings').first().json.notes },\n  ],\n}) }}",
        "options": {
          "timeout": 180000
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi"
      },
      "id": "bab5c8f4-53c5-5623-b7c8-1f75f962e60b",
      "name": "LLM extract actions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        -100
      ],
      "credentials": {
        "openAiApi": {
          "id": "openAiCourse0001",
          "name": "OpenAI (.env)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse the LLM answer (JSON text) into a clean list of action items.\nconst raw = String($input.first().json.choices?.[0]?.message?.content ?? '').trim().replace(/^```(json)?\\s*|```$/g, '');\nlet data;\ntry {\n  data = JSON.parse(raw);\n} catch (error) {\n  return [{ json: { actions: [], count: 0, error: 'answer is not valid JSON' } }];\n}\nconst items = Array.isArray(data) ? data : (data.actions ?? []);\nconst actions = items\n  .filter(item => item && String(item.task ?? '').trim())\n  .map(item => ({\n    task: String(item.task).trim(),\n    owner: String(item.owner || '미정').trim() || '미정',\n    due: String(item.due || '미정').trim() || '미정',\n  }));\nreturn [{ json: { actions, count: actions.length } }];"
      },
      "id": "2d12968a-6877-53a7-a7e4-ec7c51d893b1",
      "name": "Parse actions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        -100
      ]
    },
