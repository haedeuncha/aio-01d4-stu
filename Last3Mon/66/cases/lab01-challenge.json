{
  "webhook": "my-meeting",
  "cases": [
    {
      "name": "빈 회의록",
      "request": "requests/empty.json",
      "expect": {
        "status": 400
      }
    },
    {
      "name": "공백만",
      "body": {
        "title": "x",
        "notes": "   "
      },
      "expect": {
        "status": 400
      }
    },
    {
      "name": "제목 없음 → 회의",
      "request": "requests/no-title.json",
      "expect": {
        "equals": {
          "title": "회의"
        },
        "contains": {
          "summary": [
            "노트북"
          ]
        }
      }
    },
    {
      "name": "원래 요약도 그대로",
      "request": "requests/weekly.json",
      "expect": {
        "equals": {
          "title": "10월 16일 주간 회의"
        }
      }
    }
  ]
}
