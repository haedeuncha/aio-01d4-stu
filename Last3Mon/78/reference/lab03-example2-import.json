            {
              "id": "c1",
              "leftValue": "={{ $json.invalid / $json.total <= ($('Import webhook').first().json.body.max_invalid_ratio ?? 0.3) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "position": [
        660,
        300
      ],
      "id": "edceb049-33db-5490-bac7-bed1554f414f"
    },
    {
      "name": "Reject batch",
      "type": "n8n-nodes-base.respondToWebhook",
