      },
      "position": [
        1100,
        560
      ],
      "id": "4ba91d1f-4b86-552d-b572-08706cd4d170"
    },
    {
      "name": "Split rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const c = $('Run check').first().json;\nconst items = $('Import webhook').first().json.body.items;\nreturn c.rows.map((r, i) => ({ json: { ...r, row: items[i], batch: c.batch } }));"
      },
      "position": [
        880,
        300
      ],
      "id": "ebce06e1-7140-5292-8687-4ab2b641c047"
    },
    {
      "name": "Only passed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return $input.all().filter((i) => i.json.ok);"
      },
      "position": [
        1100,
        300
      ],
      "id": "b7a235dd-8495-5b00-a635-3dbd3920a1c4"
    },
    {
      "name": "Judge",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "parameters": {
        "promptType": "define",
        "text": "=제목: {{ $json.row.title }}\n답: {{ $json.row.answer }}",
        "options": {
          "systemMessage": "You check a company IT FAQ entry before it is published. Does the answer actually answer the title's topic? Ignore style. Return only JSON, no code fence: {\"match\": true, \"reason\": \"short reason in Korean\"}",
          "maxIterations": 1
        }
      },
      "onError": "continueRegularOutput",
      "position": [
        1320,
        300
      ],
      "id": "6273964f-6cb4-56ab-885d-2dc3faf7f7ff"
    },
    {
      "name": "Judge model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "gpt-4.1-mini"
        },
        "options": {
          "temperature": 0
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "openAiCourse0001",
          "name": "OpenAI (.env)"
        }
      },
      "position": [
        1320,
        520
      ],
      "id": "dd634caa-4367-5cdb-aac1-559d0114d7ff"
    },
    {
      "name": "Decide",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const judged = $('Only passed').all().map((item, i) => {\n  let v = { match: false, reason: 'judge unreadable' };\n  try { v = JSON.parse(String($('Judge').all()[i].json.output ?? '').replace(/^```(json)?\\s*|```$/g, '')); } catch (e) {}\n  return { ...item.json, ok: v.match === true, errors: v.match === true ? [] : ['llm_mismatch'], reason: String(v.reason ?? '') };\n});\nlet k = 0;\nreturn $('Split rows').all().map((i) => ({ json: i.json.ok ? judged[k++] : i.json }));"
      },
      "position": [
        1540,
        300
      ],
      "id": "af54c0ea-0a6a-569a-8cc5-9e4b831fda3c"
    },
    {
      "name": "Store row",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "url": "={{ $json.ok ? 'http://data-api:8800/faq/add' : 'http://data-api:8800/quarantine' }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        },
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.ok ? $json.row : { items: [{ batch: $json.batch, row: $json.row, errors: $json.errors }] }) }}"
      },
      "position": [
        1760,
        300
      ],
      "id": "b1b7176d-9a05-5f4b-82e7-71b8264ed74c"
    },
    {
      "name": "Summarize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const c = $('Run check').first().json;\nconst rows = $('Decide').all().map((i) => i.json);\nconst imported = rows.filter((r) => r.ok);\nconst quarantined = rows.filter((r) => !r.ok);\nconst codes = { ...c.codes };\nfor (const r of quarantined) for (const e of r.errors) if (e === 'llm_mismatch') codes[e] = (codes[e] ?? 0) + 1;\nreturn [{ json: { batch: c.batch, total: c.total, imported: imported.length, quarantined: quarantined.length, rejected: false,\n  score: Math.round(imported.length / c.total * 10000) / 10000, max_invalid_ratio: ($('Import webhook').first().json.body.max_invalid_ratio ?? 0.3),\n  codes, imported_ids: imported.map((r) => r.id), quarantined_ids: quarantined.map((r) => r.id), llm_calls: $('Only passed').all().length } }];"
      },
      "position": [
        1980,
        300
      ],
      "id": "9e940251-c204-5813-9457-72980199a956"
    },
