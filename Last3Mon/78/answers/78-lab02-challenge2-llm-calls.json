        "responseBody": "={{ JSON.stringify({ error: 'batch rejected', batch: $('Run check').first().json.batch, invalid_ratio: Math.round($('Run check').first().json.invalid / $('Run check').first().json.total * 10000) / 10000, max_invalid_ratio: ($('Import webhook').first().json.body.max_invalid_ratio ?? 0.3), codes: $('Run check').first().json.codes, llm_calls: 0 }) }}",
        "options": {
          "responseCode": 422
        }
      },
      "position": [
        1320,
        560
      ],
      "id": "50f5afd9-e4fb-5f03-b99c-b0bbbd02f637"
    },
    {
      "name": "Log rejected",
