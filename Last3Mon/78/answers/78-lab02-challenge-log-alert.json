      },
      "position": [
        2200,
        300
      ],
      "id": "0fb77808-55c4-54fc-b1ba-9bb98478a8dc"
    },
    {
      "name": "Low score?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
