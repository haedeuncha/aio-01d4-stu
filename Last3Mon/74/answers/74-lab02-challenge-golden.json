{
  "webhook": "my-helpdesk",
  "cases": [
    {
      "name": "VPN · 해결 방법",
      "request": "requests/faq-vpn.json",
      "expect": {
        "equals": {
          "route": "자동 답변"
        },
        "contains": {
          "answer": [
            "인증서"
          ]
        }
      }
    },
    {
      "name": "VPN · 순서도 (업데이트)",
      "request": "requests/faq-vpn.json",
      "expect": {
        "contains": {
          "answer": [
            "업데이트",
            "최신"
          ]
        }
      }
    },
    {
      "name": "비밀번호 · 해결 방법",
      "request": "requests/faq-password.json",
      "expect": {
        "contains": {
          "answer": [
            "비밀번호 찾기",
            "휴대폰"
          ]
        }
      }
    },
    {
      "name": "프린터 · 해결 방법",
      "request": "requests/faq-printer.json",
      "expect": {
        "contains": {
          "answer": [
            "대기열",
            "전원"
          ]
        }
      }
    },
    {
      "name": "메일함 · 해결 방법",
      "request": "requests/faq-mail.json",
      "expect": {
        "contains": {
          "answer": [
            "보관함",
            "삭제"
          ]
        }
      }
    },
    {
      "name": "접수 처리 중 · 상태와 예정일",
      "request": "requests/ticket-own.json",
      "expect": {
        "contains": {
          "answer": [
            "처리 중"
          ]
        }
      }
    },
    {
      "name": "접수 처리 중 · 예정일",
      "request": "requests/ticket-own.json",
      "expect": {
        "contains": {
          "answer": [
            "10월 20일",
            "20일"
          ]
        }
      }
    },
    {
      "name": "접수 처리 완료",
      "request": "requests/ticket-done.json",
      "expect": {
        "contains": {
          "answer": [
            "처리 완료",
            "완료"
          ]
        }
      }
    },
    {
      "name": "포털로 떠넘기지 않기",
      "request": "requests/faq-printer.json",
      "expect": {
        "not_contains": {
          "answer": [
            "IT 포털을 확인",
            "포털을 참고"
          ]
        }
      }
    }
  ]
}
