    {
      "name": "Golden questions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const release = String($('Check webhook').first().json.body.release);\nconst golden = [\n  { question: 'VPN 접속이 자꾸 끊겨요. 어떻게 하나요?', user: '이준호', expect: ['인증서'] },\n  { question: '비밀번호를 잊어버렸어요. 재설정은 어떻게 하나요?', user: '한지훈', expect: ['비밀번호 찾기', '휴대폰'] },\n  { question: '프린터 출력이 안 돼요', user: '최유진', expect: ['대기열', '전원'] },\n  { question: '메일함 용량이 꽉 찼대요', user: '김민지', expect: ['보관함', '삭제'] },\n  { question: 'T-1002 처리 상태 알려 주세요', user: '박서연', expect: ['처리 중'] },\n  { question: 'T-1001 어떻게 됐나요?', user: '이준호', expect: ['처리 완료', '완료'] },\n];\nreturn golden.map((g) => ({ json: { ...g, release, t0: Date.now() } }));"
      },
      "position": [
        440,
        300
      ],
      "id": "9b1783b9-375e-509d-8990-992a70b79062"
    },
    {
      "name": "Ask helpdesk",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "url": "http://localhost:5678/webhook/my-helpdesk",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          },
          "timeout": 30000
        },
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ question: $json.question, user: $json.user, release: $json.release }) }}"
      },
      "position": [
        660,
        300
      ],
      "id": "b2944162-4641-5f43-9468-89d4d3cab67d"
    },
    {
      "name": "Judge",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const golden = $('Golden questions').all().map((item) => item.json);\nconst answers = $input.all().map((item) => item.json);\nconst rows = golden.map((g, i) => {\n  const a = answers[i] ?? {};\n  const text = String(a.answer ?? '');\n  const ok = !a.error && g.expect.some((word) => text.includes(word)) && (a.version?.release === g.release);\n  return { question: g.question, ok, release_seen: a.version?.release ?? null };\n});\nconst passed = rows.filter((row) => row.ok).length;\nconst failed = rows.filter((row) => !row.ok).map((row) => row.question);\nconst seconds = Math.round((Date.now() - golden[0].t0) / 100) / 10;\nreturn [{ json: { release: golden[0].release, passed, total: rows.length, failed, seconds,\n  verdict: passed === rows.length ? 'promote' : 'rollback' } }];"
      },
      "position": [
        880,
        300
      ],
      "id": "00c58707-3b5f-5880-921e-b664bb6c6001"
    },
    {
      "name": "Send verdict",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ...$('Judge').first().json, recorded: $json.stored === true }) }}",
        "options": {}
      },
      "position": [
        1320,
