      ],
      "id": "37a5dc22-d6e9-58c7-ac41-fdafcd25d9d0",
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "http://data-api:8800/gates/helpdesk",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ release: $json.release, verdict: $json.verdict, passed: $json.passed, total: $json.total, failed: $json.failed, seconds: $json.seconds, source: 'my-release-check' }) }}",
        "options": {
          "timeout": 3000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      }
    }
