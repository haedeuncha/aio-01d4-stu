    {
      "name": "Parse tasks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        980,
        300
      ],
      "parameters": {
        "jsCode": "const body = $('Router webhook').first().json.body;\nconst user = String(body.user).trim();\nconst { lanes: LANES, shared: SHARED } = $('Lane settings').first().json;\nconst today = $now.setZone('Asia/Seoul').toFormat('yyyy-MM-dd');\nconst isDate = s => typeof s === 'string' && /^\\d{4}-\\d{2}-\\d{2}$/.test(s) && !isNaN(Date.parse(s + 'T00:00:00Z')) && new Date(s + 'T00:00:00Z').toISOString().slice(0, 10) === s;\n// LLM이 날짜를 지어내지 않았는지: 요청 문장에 날짜를 말하는 표현이 있어야 날짜를 믿는다\nconst mentionsDate = text => /\\d{1,2}\\s*월|\\d{1,2}\\s*일|\\d{4}-\\d{1,2}-\\d{1,2}|\\d{1,2}\\/\\d{1,2}|오늘|내일|모레|글피|요일|이번\\s*주|다음\\s*주|주말|월말|월초/.test(String(text ?? ''));\nfunction parseJson(output) {\n  const raw = String(output ?? '');\n  const start = raw.indexOf('{');\n  const end = raw.lastIndexOf('}');\n  if (start < 0 || end < start) throw new Error('no JSON');\n  return JSON.parse(raw.slice(start, end + 1));\n}\nconst DATE_FIELDS = ['start', 'end', 'date'];\nconst said = mentionsDate(body.message);\nconst clean = (key, value) => {\n  const text = typeof value === 'string' ? value.trim() : (value ?? '');\n  if (DATE_FIELDS.includes(key)) return said && isDate(text) ? text : '';  // 날짜는 요청에 날짜 표현이 있을 때만\n  return text;\n};\n// 갈래 설정의 body: \"Agent가 받는 이름\" → \"user\" | \"text\" | 칸 이름 | \"a|b\"(앞이 비면 뒤) | \"body.칸\"(웹훅 입력) | \"{칸} 글자\"(끼워 넣기)\nconst pick = (spec, task) => {\n  if (spec.includes('{')) return spec.replace(/\\{(\\w+)\\}/g, (_, key) => task.fields[key] ?? '').trim();\n  for (const name of spec.split('|')) {\n    const value = name === 'user' ? user : name === 'text' ? task.text : name.startsWith('body.') ? body[name.slice(5)] : task.fields[name];\n    if (value !== undefined && value !== '') return value;\n  }\n  return '';\n};\ntry {\n  const parsed = parseJson($json.output);\n  if (!Array.isArray(parsed.tasks)) throw new Error('no tasks');\n  const shared = {};\n  for (const key of SHARED) shared[key] = clean(key, (parsed.shared || {})[key]);\n  const tasks = parsed.tasks\n    .filter(t => t && typeof t.text === 'string' && t.text.trim())\n    .map(t => {\n      const lane = LANES[t.type];\n      const type = lane ? t.type : 'other';\n      const fields = { ...shared };\n      for (const [key, value] of Object.entries(t)) if (!['type', 'text'].includes(key)) fields[key] = clean(key, value);\n      const task = { type, text: t.text.trim(), fields, agent: lane ? lane.agent : '담당자 연결', missing: [], ask: '' };\n      if (!lane) return { ...task, lane: 'other' };\n      task.missing = (lane.required || []).filter(key => !fields[key]);\n      if (task.missing.length) return { ...task, lane: 'needs input', ask: lane.ask || `${task.missing.join(', ')}을(를) 알려 주세요.` };\n      task.request = Object.fromEntries(Object.entries(lane.body).map(([key, spec]) => [key, pick(spec, task)]));\n      return { ...task, lane: 'agent' };\n    });\n  return [{ json: { count: tasks.length, tasks } }];\n} catch (error) {\n  return [{ json: { count: 0, tasks: [], error: 'split_failed' } }];\n}"
      }
    },
