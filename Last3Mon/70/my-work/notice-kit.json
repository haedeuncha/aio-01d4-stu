    {
      "name": "Kind settings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        300
      ],
      "parameters": {
        "jsCode": "// The only per-kind part of the template: one row per notice kind.\nconst KINDS = {\n  \"maintenance\": {\n    \"label\": \"점검\",\n    \"prefix\": \"[점검 안내]\",\n    \"max_length\": 600,\n    \"required_phrases\": [],\n    \"extra\": \"Say clearly what cannot be used during the work and what to do after it.\"\n  },\n  \"security\": {\n    \"label\": \"보안\",\n    \"prefix\": \"[보안 안내]\",\n    \"max_length\": 500,\n    \"required_phrases\": [\n      \"IT팀은 절대 비밀번호를 묻지 않습니다.\"\n    ],\n    \"extra\": \"Tell readers what to do and what never to do. Never ask for passwords.\"\n  },\n  \"training\": {\n    \"label\": \"교육\",\n    \"prefix\": \"[교육 안내]\",\n    \"max_length\": 800,\n    \"required_phrases\": [\n      \"신청은 IT 포털에서 할 수 있습니다.\"\n    ],\n    \"extra\": \"Say who should attend, when and where, and how to apply.\"\n  },\n  \"survey\": {\n    \"label\": \"설문\",\n    \"prefix\": \"[설문 안내]\",\n    \"max_length\": 500,\n    \"required_phrases\": [\n      \"응답은 익명으로 처리됩니다.\"\n    ],\n    \"extra\": \"Say the purpose of the survey, the deadline and how long it takes.\"\n  }\n};\nconst body = $('Kit webhook').first().json.body;\nconst ALIASES = { '점검': 'maintenance', '보안': 'security', '교육': 'training', '설문': 'survey' };\nconst raw = String(body.kind ?? '').trim().toLowerCase();\nconst kind = ALIASES[raw] ?? raw;\nif (!KINDS[kind]) return [{ json: { known: false, kinds: Object.keys(KINDS) } }];\nreturn [{ json: { known: true, kind, ...KINDS[kind] } }];"
      }
    },
    {
      "name": "Known kind?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        760,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
