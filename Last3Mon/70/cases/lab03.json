{
  "webhook": "my-rule-check",
  "cases": [
    {
      "name": "바깥 링크",
      "request": "requests/module-external-link.json",
      "expect": {
        "equals": {
          "codes": [
            "external_link"
          ]
        }
      }
    },
    {
      "name": "사내 링크는 통과",
      "request": "requests/module-intra-link.json",
      "expect": {
        "equals": {
          "passed": true,
          "codes": []
        }
      }
    },
    {
      "name": "허용 도메인을 직접 줌",
      "body": {
        "facts": "10월 23일(목) 22:00~24:00 메일 서버 점검. 점검 중에는 메일을 보내고 받을 수 없음. 점검이 끝나면 메일 프로그램을 다시 열면 됨.",
        "draft": "[점검 안내] 메일 서버 점검\n10월 23일(목) 22:00~24:00에 메일 서버 점검이 있습니다.\n점검 중에는 메일을 보내고 받을 수 없습니다.\n자세한 내용: http://bit.ly/mail-check",
        "max_length": 600,
        "required_phrases": [],
        "allowed_domains": [
          "bit.ly"
        ]
      },
      "expect": {
        "equals": {
          "passed": true
        }
      }
    },
    {
      "name": "예전 호출(allowed_domains 없음)도 그대로",
      "request": "requests/module-personal-info.json",
      "expect": {
        "equals": {
          "codes": [
            "personal_info"
          ]
        }
      }
    }
  ]
}
