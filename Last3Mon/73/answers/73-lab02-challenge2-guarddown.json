    {
      "name": "Parse guard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const raw = String($json.output ?? '').trim().replace(/^```(json)?\\s*|```$/g, '');\nlet verdict = { attack: false, reason: '' };\ntry { verdict = JSON.parse(raw); } catch (error) { verdict = { attack: true, reason: 'guard answer unreadable' }; }\nreturn [{ json: { blocked: verdict.attack === true, reason: String(verdict.reason ?? '') } }];"
      },
      "position": [
        1540,
