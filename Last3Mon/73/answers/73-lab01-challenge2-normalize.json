      ],
      "id": "df17ddb1-d5f3-5126-94cf-10770c4e6b6a"
    },
    {
      "name": "Reject invalid",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ error: 'invalid request', codes: $json.codes }) }}",
        "options": {
          "responseCode": 400
        }
      },
      "position": [
        880,
        600
      ],
      "id": "3e8c2f49-37e6-57a1-aee8-359e408371d8"
    },
    {
      "name": "Injection rules",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const rules = [\n  /(이전|앞의|위의|지금까지의?)\\s*(지시|지침|명령)\\S*\\s*(모두|다)?\\s*(무시|잊)/i,\n  /ignore\\s+(all\\s+)?(previous|prior|above)\\s+(instructions|rules)/i,\n  /(시스템|system)\\s*(프롬프트|prompt)/i,\n  /(개발자|디버그|developer|debug)\\s*(모드|mode)/i,\n  /(규칙|지시|지침)\\S*\\s*(은|는|을|를)?\\s*잊/i,\n  /(숨겨진|숨은)\\s*(설정|지침|규칙)/i,\n  /처음\\s*받은\\s*(지침|지시)/i,\n  /너는\\s*이제부터|you\\s+are\\s+now/i,\n  /관리자\\s*(권한|모드)/i,\n  /다른\\s*(직원|사람)\\S*\\s*(의)?\\s*(접수|문의|티켓)/i,\n  /역할\\s*설명/i\n];\nconst raw = String($('Question webhook').first().json.body.question ?? '');\nconst clean = raw.normalize('NFKC').replace(/[\\u200B-\\u200D\\u2060\\uFEFF\\u00AD]/g, '');\nconst compact = clean.replace(/[\\s.\\-_*·,|/]+/g, '');\nconst hit = rules.find((rule) => rule.test(clean) || rule.test(compact));\nreturn [{ json: { blocked: Boolean(hit), rule: hit ? String(hit) : '', cleaned: clean !== raw } }];"
      },
      "position": [
        880,
        300
      ],
      "id": "3ad34abb-9b99-5902-8b9c-1159ccbb7a79"
    },
    {
