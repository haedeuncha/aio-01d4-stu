    {
      "name": "Validate input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const body = $('Question webhook').first().json.body;\nconst question = String(body.question ?? '').trim();\nconst codes = [];\nif (!question) codes.push('question_required');\nif (question.length > 500) codes.push('too_long');\nif ($json.error || !$json.name) codes.push('unknown_user');\nreturn [{ json: { valid: codes.length === 0, codes } }];"
      },
      "position": [
        440,
        300
      ],
      "id": "b0c17411-22f8-5833-8027-8f5e4f2e9ea0"
    },
    {
      "name": "Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "position": [
