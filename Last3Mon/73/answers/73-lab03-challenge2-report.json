    {
      "name": "Summarize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "id": "8b2be6af-ff99-5fe4-ba24-f1f2c91567b8",
      "parameters": {
        "jsCode": "const events = $json.events ?? [];\nconst blocked = { rule: 0, guard: 0, output_filter: 0 };\nlet answered = 0, masked = 0;\nfor (const e of events) {\n  if (e.blocked_by) blocked[e.blocked_by] = (blocked[e.blocked_by] ?? 0) + 1; else answered += 1;\n  masked += Number(e.masked ?? 0);\n}\nconst text = JSON.stringify(events);\nconst pii = /01[016789][-. ]?\\d{3,4}[-. ]?\\d{4}|[\\w.+-]+@[\\w-]+\\.[\\w.]+|\\d{6}[- ]?[1-4]\\d{6}/g;\nconst pii_in_log = (text.match(pii) ?? []).length;\nconst users = [...new Set(events.filter((e) => e.blocked_by).map((e) => e.user))];\nreturn [{ json: { total: events.length, answered, blocked, masked, pii_in_log, blocked_users: users } }];"
      }
    },
    {
      "name": "Send report",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
