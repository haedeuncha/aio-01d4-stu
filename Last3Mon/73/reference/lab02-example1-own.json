      "name": "Build result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const steps = $json.intermediateSteps ?? [];\nconst tools_used = [...new Set(steps.map((step) => step.action?.tool).filter(Boolean))];\nreturn [{ json: { route: '자동 답변', answer: String($json.output ?? '').trim(), tools_used } }];"
      },
