    {
      "name": "Check employee",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "url": "=http://data-api:8800/employees/{{ encodeURIComponent($('Question webhook').first().json.body.user ?? '') }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "position": [
        220,
        300
      ],
      "id": "756718e5-c472-5e6e-81bc-808554171844"
    },
    {
      "name": "Validate input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const body = $('Question webhook').first().json.body;\nconst question = String(body.question ?? '').trim();\nconst codes = [];\nif (!question) codes.push('question_required');\nif (question.length > 500) codes.push('too_long');\nif ($json.error || !$json.name) codes.push('unknown_user');\nreturn [{ json: { valid: codes.length === 0, codes } }];"
      },
      "position": [
        440,
        300
      ],
      "id": "52d1b25d-cb01-5521-abc5-fc7e92cc5b24"
    },
    {
      "name": "Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "position": [
        660,
        300
      ],
      "id": "5b03f81a-e353-5d5b-a2e4-4bb73cd5ae5f"
    },
    {
      "name": "Reject invalid",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ error: 'invalid request', codes: $json.codes }) }}",
        "options": {
          "responseCode": 400
        }
      },
      "position": [
        880,
        600
      ],
      "id": "8b8f2304-8166-52c3-8877-6f5a77676ad7"
    },
    {
      "name": "Injection rules",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const rules = [\n  /(이전|앞의|위의|지금까지의?)\\s*(지시|지침|명령)\\S*\\s*(모두|다)?\\s*(무시|잊)/i,\n  /ignore\\s+(all\\s+)?(previous|prior|above)\\s+(instructions|rules)/i,\n  /(시스템|system)\\s*(프롬프트|prompt)/i,\n  /(개발자|디버그|developer|debug)\\s*(모드|mode)/i,\n  /(규칙|지시|지침)\\S*\\s*(은|는|을|를)?\\s*잊/i,\n  /(숨겨진|숨은)\\s*(설정|지침|규칙)/i,\n  /처음\\s*받은\\s*(지침|지시)/i,\n  /너는\\s*이제부터|you\\s+are\\s+now/i,\n  /관리자\\s*(권한|모드)/i,\n  /다른\\s*(직원|사람)\\S*\\s*(의)?\\s*(접수|문의|티켓)/i,\n  /역할\\s*설명/i\n];\nconst raw = String($('Question webhook').first().json.body.question ?? '');\nconst hit = rules.find((rule) => rule.test(raw));\nreturn [{ json: { blocked: Boolean(hit), rule: hit ? String(hit) : '' } }];"
      },
      "position": [
        880,
        300
      ],
      "id": "75c43375-e7d5-5131-a8b0-7630b1ec6f56"
    },
    {
      "name": "Blocked by rule?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
