# Course settings for every lab from day 64 (workflow-lab, kits, n8n credential script).
# 1) Copy this file to .env in the same folder:   cp .env.example .env
# 2) Put your OpenAI API key below.
# .env is listed in .gitignore: never commit it, never paste the key into a workflow or a document.

# --- OpenAI (course default) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-large

# --- workflow-lab (miniflow) ---
# mock: no LLM call (tests, offline) / openai: course default / ollama: local models (no key yet)
MINIFLOW_LLM=openai
# When an OpenAI call fails, try the local Ollama models once more (day 64: WSL service, day 65+: container).
MINIFLOW_LLM_FALLBACK=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
EMBED_MODEL=bge-m3
