    {
      "name": "Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const cases = $('Eval webhook').first().json.body.cases;\nconst answers = $input.all().map((i) => i.json);\nconst results = cases.map((c, i) => {\n  const a = answers[i] ?? {};\n  const areaOk = a.area === c.area;\n  const refusedOk = Boolean(a.refused) === Boolean(c.refused);\n  const numberOk = !c.numbers || c.numbers.some((n) => String(a.answer ?? '').includes(n));\n  const grounded = a.refused ? true : a.numbers_ok === true;\n  return { question: c.question, area: a.area ?? null, ok: areaOk && refusedOk && numberOk && grounded, area_ok: areaOk, refused_ok: refusedOk, number_ok: numberOk, grounded, answer: a.answer ?? null };\n});\nconst n = results.length, cnt = (k) => results.filter((r) => r[k]).length;\nreturn [{ json: { total: n, passed: cnt('ok'), score: n ? Math.round(cnt('ok') / n * 10000) / 10000 : 0,\n  area_ok: cnt('area_ok'), refused_ok: cnt('refused_ok'), number_ok: cnt('number_ok'), grounded: cnt('grounded'),\n  failed: results.filter((r) => !r.ok) } }];"
      },
      "position": [
        880,
        300
      ],
      "id": "97e3d80b-97c6-534c-b854-247fbb2d3aa1"
    },
