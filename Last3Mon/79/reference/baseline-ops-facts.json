    {
      "name": "Make facts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// team baseline: the morning dashboard we put together last month\nconst logs = $('Get logs').first().json.logs ?? [];\nconst total = logs.length, errors = logs.filter((l) => l.status === 'error').length;\nconst alerts = $('Get alerts').first().json, dlq = $('Get DLQ').first().json, budget = $('Get budget').first().json;\nreturn [{ json: {\n  runs: { total, errors, error_rate: total ? errors / total * 100 : null },\n  alerts: { count: alerts.count },\n  dlq: { size: dlq.size },\n  cost: { used_usd: budget.used_usd, daily_usd: budget.daily_usd },\n} }];"
      },
      "position": [
        1100,
        300
      ],
      "id": "7dc18d76-23f3-583c-95e3-4d6c246c218a"
    },
    {
      "name": "Send result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "parameters": {
        "respondWith": "json",
