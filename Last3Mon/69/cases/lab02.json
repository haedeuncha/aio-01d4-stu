{
  "webhook": "my-notice",
  "cases": [
    {
      "name": "메일 점검 · 게시",
      "request": "requests/notice-mail.json",
      "expect": {
        "equals": {
          "published": true,
          "codes": []
        },
        "contains": {
          "route": [
            "게시 가능"
          ],
          "notice": [
            "22:00"
          ]
        }
      }
    },
    {
      "name": "VPN · 게시",
      "request": "requests/notice-vpn.json",
      "expect": {
        "equals": {
          "published": true,
          "codes": []
        },
        "contains": {
          "notice": [
            "10월 24일"
          ]
        }
      }
    },
    {
      "name": "연락처가 든 사실 · 고쳐서 게시",
      "request": "requests/notice-phone.json",
      "expect": {
        "equals": {
          "published": true,
          "codes": []
        },
        "contains": {
          "route": [
            "게시 가능"
          ]
        },
        "not_contains": {
          "notice": [
            "010-1234-5678",
            "minji.kim@example.com"
          ]
        }
      }
    },
    {
      "name": "사실 없음",
      "request": "requests/notice-empty.json",
      "expect": {
        "status": 400
      }
    }
  ]
}
