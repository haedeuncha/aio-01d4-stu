      "parameters": {
        "jsCode": "// Join the two editor results (n8n runs the two branches one after the other) with the approved notice.\nconst base = $('Final notice').first().json;\nconst [first, second] = $input.all().map(item => String(item.json.output ?? '').trim());\nconst title = $('Make title').first().json.output ?? first;\nconst chat = $('Make chat message').first().json.output ?? second;\nreturn [{ json: { ...base, title: String(title).trim(), chat: String(chat).trim(), ...(base.steps ? { steps: [...base.steps, 'editor'] } : {}) } }];"
      }
