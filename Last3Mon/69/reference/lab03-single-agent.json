{
  "name": "69 Single agent notice (reference · Lab 03 comparison)",
  "nodes": [
    {
      "name": "Single webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "my-single",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "name": "Has facts?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        200,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c0",
              "leftValue": "={{ $json.body.facts }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "name": "Reject empty",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        420,
        500
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{ \"error\": \"facts are required\" }",
        "options": {
          "responseCode": 400
        }
      }
    },
    {
      "name": "Notice agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        420,
        300
      ],
      "parameters": {
        "promptType": "define",
        "text": "=요청: {{ $('Single webhook').first().json.body.request || 'IT 공지' }}\n사실:\n{{ $('Single webhook').first().json.body.facts }}",
        "options": {
          "systemMessage": "You are the writer of company IT notices, in Korean. Write one notice from the facts only. First line: a title in [square brackets]. Then 3 to 6 short lines. Copy every date and time exactly as written in the facts (for example 10월 23일, 22:00~24:00). Do not add promises, compensation, dates, people or contacts that are not in the facts. If reviewer feedback is given, rewrite the previous draft so that every point of the feedback is fixed, and change nothing else. Fixing never means adding: when you remove a phone number or e-mail address, do not put any other number, extension or address in its place. Never include phone numbers or e-mail addresses. Keep the notice under 600 characters. Return only the notice text.",
          "maxIterations": 2
        }
      }
    },
    {
      "name": "OpenAI chat model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        380,
        520
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "gpt-4.1-mini"
        },
        "options": {
          "temperature": 0
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "openAiCourse0001",
          "name": "OpenAI (.env)"
        }
      }
    },
    {
      "name": "Build result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "jsCode": "const notice = String($json.output ?? '').trim();\nreturn [{ json: { route: '게시 가능', published: true, rounds: 1, notice, codes: [], steps: ['single'] } }];"
      }
    },
    {
      "name": "Send result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        900,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Single webhook": {
      "main": [
        [
          {
            "node": "Has facts?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has facts?": {
      "main": [
        [
          {
            "node": "Notice agent",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Reject empty",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI chat model": {
      "ai_languageModel": [
        [
          {
            "node": "Notice agent",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Notice agent": {
      "main": [
        [
          {
            "node": "Build result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build result": {
      "main": [
        [
          {
            "node": "Send result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
