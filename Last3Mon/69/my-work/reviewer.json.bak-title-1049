    {
      "name": "Build review",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1140,
        300
      ],
      "parameters": {
        "jsCode": "// The reviewer's contract: { passed, codes, issues }.\nconst raw = String($json.output ?? '').trim().replace(/^```(json)?\\s*|```$/g, '');\nlet unsupported = [];\ntry { unsupported = JSON.parse(raw).unsupported ?? []; } catch (error) { unsupported = []; }\n// Check the LLM's verdict too: a sentence whose words all appear in the facts is supported.\nconst facts = String($('Review webhook').first().json.body.facts ?? '');\nconst words = sentence => sentence.match(/[가-힣A-Za-z0-9]{2,}/g) ?? [];\nunsupported = unsupported.map(String).filter(Boolean)\n  .filter(sentence => words(sentence).some(word => !facts.includes(word)));\nconst issues = [...$('Rule checks').first().json.rule_issues];\nif (unsupported.length) issues.push({ code: 'unsupported_claim', detail: unsupported.join(' / ') });\nreturn [{ json: { passed: issues.length === 0, codes: issues.map(issue => issue.code), issues } }];"
      }
    },
