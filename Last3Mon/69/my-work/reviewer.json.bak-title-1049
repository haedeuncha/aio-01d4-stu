      "name": "Rule checks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        300
      ],
      "parameters": {
        "jsCode": "// Rules that must give the same answer every time are checked in code, not by the LLM.\nconst body = $('Review webhook').first().json.body;\nconst facts = String(body.facts ?? '');\nconst draft = String(body.draft ?? '');\nconst squeeze = text => text.replace(/\\s+/g, '');\nconst tokens = [...new Set(facts.match(/\\d{1,2}월\\s?\\d{1,2}일|\\d{1,2}:\\d{2}/g) ?? [])];\nconst missing = tokens.filter(token => !squeeze(draft).includes(squeeze(token)));\nconst issues = [];\nif (missing.length) issues.push({ code: 'missing_fact', detail: missing.join(', ') });\nconst personal = draft.match(/01[016789]-?\\d{3,4}-?\\d{4}|[\\w.+-]+@[\\w-]+\\.[\\w.]+/g) ?? [];\nif (personal.length) issues.push({ code: 'personal_info', detail: personal.join(', ') });\nif (draft.length > 600) issues.push({ code: 'too_long', detail: `${draft.length}자 (600자 이하)` });\nreturn [{ json: { rule_issues: issues } }];"
      }
    },
    {
      "name": "Claim check agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        780,
        300
      ],
      "parameters": {
        "promptType": "define",
        "text": "=사실(facts):\n{{ $('Review webhook').first().json.body.facts }}\n\n공지 초안(draft):\n{{ $('Review webhook').first().json.body.draft }}",
        "options": {
          "systemMessage": "You check a Korean IT notice draft against its facts. List every statement in the draft that promises, schedules or states something that is not in the facts: compensation, gifts, new dates or times, extra services, people or contacts. Anything that appears in the facts, even reworded, shortened or partly left out, is supported (a contact person named in the facts is supported). Polite phrases (thanks, apologies, asking for understanding, '문의 바랍니다') are not claims. Return only JSON, no code fence: {\"unsupported\": [\"exact sentence from the draft\"]}",
          "maxIterations": 2
        }
      }
    },
    {
      "name": "OpenAI chat model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
