    },
    {
      "name": "DLQ가 비었음",
      "url": "http://localhost:8800/dlq/list",
      "body": {},
      "expect": {
        "equals": {
          "size": 0
        }
      }
    },
    {
      "name": "접수 건은 2개 (중복 없음)",
      "url": "http://localhost:8800/tickets-created/list",
      "body": {},
      "expect": {
        "equals": {
          "count": 2
        }
      }
    },
    {
      "name": "한 번 더 돌려도 할 일 없음",
      "webhook": "my-replay",
      "body": {},
      "expect": {
        "equals": {
          "replayed": 0
        }
      }
    }
  ]
